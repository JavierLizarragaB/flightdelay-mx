# Copia este archivo a .env y ajusta los valores. Nunca pongas llaves de AWS aquí:
# las credenciales viven en el perfil de AWS CLI (~/.aws), no en el repo.

AWS_PROFILE=flightdelay
AWS_REGION=us-east-1

# Bucket del lakehouse (debe ser único en todo AWS)
FD_BUCKET=flightdelay-mx-CAMBIAME

# Rango de meses a ingerir (YYYY-MM)
FD_START_YM=2023-01
FD_END_YM=2026-08

# Patrón de descarga BTS ({year}, {month} sin cero a la izquierda)
FD_BTS_URL_TEMPLATE=https://transtats.bts.gov/PREZIP/On_Time_Reporting_Carrier_On_Time_Performance_1987_present_{year}_{month}.zip

# App -> API
API_URL=http://localhost:8000
API_TIMEOUT_SECONDS=5
API_MAX_RETRIES=2
